{
    "name": "jui-api-doc",
    "private": true,
    "type": "module",
    "scripts": {
        "docs:gen:core-ts": "typedoc --options typedoc.core-ts.json",
        "docs:gen:graph-ts": "typedoc --options typedoc.graph-ts.json",
        "docs:gen:chart-vue-register": "typedoc --options typedoc.chart-vue-register.json",
        "docs:gen:components": "node scripts/generate-component-docs.mjs",
        "docs:gen": "npm run docs:gen:core-ts && npm run docs:gen:graph-ts && npm run docs:gen:chart-vue-register && npm run docs:gen:components",
        "docs:dev": "npm run docs:gen && vitepress dev .",
        "docs:build": "npm run docs:gen && vitepress build ."
    },
    "devDependencies": {
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.13.1",
        "typedoc-vitepress-theme": "^1.1.4",
        "vitepress": "^1.6.4",
        "vue-component-meta": "^3.3.11",
        "typescript": "~6.0.2"
    }
}
